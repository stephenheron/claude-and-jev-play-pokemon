{
  "name": "pokered-harness",
  "version": "1.0.0",
  "description": "Pokémon Red in a Node Game Boy emulator: raw button hooks, live game state from memory, a browser viewer and streaming. Bring your own ROM.",
  "scripts": {
    "start": "node --no-node-snapshot --import tsx src/host.ts",
    "setup": "bash scripts/setup.sh",
    "gen": "tsx scripts/gen-data.ts",
    "typecheck": "tsc"
  },
  "keywords": [],
  "author": "Christian Mathiesen",
  "license": "GPL-2.0-or-later",
  "dependencies": {
    "isolated-vm": "^7.0.1",
    "serverboy": "^0.0.7",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "private": true,
  "main": "src/index.ts",
  "engines": {
    "node": ">=24"
  }
}
