ROM_PATH=roms/red.gb

# Emulation speed: 0 = as fast as possible, 1 = real time (npm start --speed overrides)
SPEED=1
# Local viewer port (listens on 127.0.0.1 only)
PORT=8787
# Folder watched for the bot (bots/bot.js)
BOTS_DIR=bots

# Live stream (optional): YouTube stream key, or a full STREAM_URL (rtmp://… or a local .mkv for testing)
YOUTUBE_STREAM_KEY=

# Jev via OpenRouter (optional): lets bots call jev(). The key stays in the host.
OPENROUTER_API_KEY=
# JEV_MODEL=typesafe/jev-1.13
# JEV_ZDR=1

# Bot improver (optional): a Claude Code session in Docker that improves bots/ on start-up and every few minutes.
# Get a token with `claude setup-token` (uses your Claude subscription). It is passed into the container.
CLAUDE_CODE_OAUTH_TOKEN=
# IMPROVER=off
# IMPROVER_INTERVAL_MIN=5
# IMPROVER_TIMEOUT_MIN=10
# IMPROVER_MODEL=claude-opus-5-5
# After this many sessions with no game progress (badges, story events, Pokémon owned, new maps), the next session is
# a "deep" one: it gets IMPROVER_DEEP_TIMEOUT_MIN minutes and is told to find the root cause instead of patching.
# IMPROVER_STALL_SESSIONS=4
# IMPROVER_DEEP_TIMEOUT_MIN=30
