ROM_PATH=roms/red.gb

# Emulation speed: 0 = as fast as possible, 1 = real time (npm start --speed overrides)
SPEED=1
# Local viewer port (listens on 127.0.0.1 only)
PORT=8787
# Folder watched for the bot (bots/bot.js)
BOTS_DIR=bots

# Live stream (optional): YouTube stream key, or a full STREAM_URL (rtmp://… or a local .mkv for testing)
YOUTUBE_STREAM_KEY=

# Jev via OpenRouter (optional): lets bots call jev(). The key stays in the host.
OPENROUTER_API_KEY=
# JEV_MODEL=typesafe/jev-1.13
# JEV_ZDR=1
